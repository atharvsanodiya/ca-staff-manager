{
  "name": "ca-staff-manager",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute ca-staff-db --local --file=./migrations/001_init.sql",
    "db:migrate:remote": "wrangler d1 execute ca-staff-db --remote --file=./migrations/001_init.sql",
    "db:seed:local": "wrangler d1 execute ca-staff-db --local --file=./migrations/002_seed.sql",
    "db:seed:remote": "wrangler d1 execute ca-staff-db --remote --file=./migrations/002_seed.sql"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "jose": "^5.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
